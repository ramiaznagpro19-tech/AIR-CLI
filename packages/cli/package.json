{
  "name": "@air-cli/air-cli",
  "private": true,
  "version": "0.26.1",
  "description": "AIR CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramiaznagpro19-tech/AIR-CLI.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "air": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/src/export/index.d.ts",
      "import": "./dist/src/export/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "start": "node dist/index.js",
    "debug": "node --inspect-brk dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-i18n": "tsx ../../scripts/check-i18n.ts"
  },
  "files": [
    "dist"
  ],
  "config": {
    "sandboxImageUri": "ghcr.io/ramiaznagpro19-tech/air-cli:0.26.1"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.0",
    "@a2a-js/sdk": "^1.1.0",
    "@agentclientprotocol/sdk": "^0.14.1",
    "@google/genai": "2.6.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "@qwen-code/acp-bridge": "file:../acp-bridge",
    "@qwen-code/audio-capture": "file:../audio-capture",
    "@qwen-code/channel-base": "file:../channels/base",
    "@qwen-code/channel-dws": "file:../channels/dws",
    "@qwen-code/channel-email": "file:../channels/email",
    "@qwen-code/channel-github": "file:../channels/github",
    "@qwen-code/channel-gitlab": "file:../channels/gitlab",
    "@qwen-code/channel-telegram": "file:../channels/telegram",
    "@qwen-code/qwen-code-core": "file:../core",
    "@qwen-code/sdk": "file:../sdk-typescript",
    "@qwen-code/web-templates": "file:../web-templates",
    "ansi-escapes": "^7.3.0",
    "ansi-regex": "^6.2.2",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "command-exists": "^1.2.9",
    "diff": "^7.0.0",
    "dotenv": "^17.1.0",
    "express": "^5.2.1",
    "fast-deep-equal": "^3.1.3",
    "fzf": "^0.5.2",
    "glob": "^10.5.0",
    "highlight.js": "^11.11.1",
    "ink": "7.0.3",
    "ink-gradient": "^3.0.0",
    "ink-link": "^4.1.0",
    "ink-spinner": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "lowlight": "^3.3.0",
    "markdown-it": "^15.0.0",
    "minimatch": "^9.0.4",
    "open": "^10.2.0",
    "p-limit": "^7.3.0",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "punycode": "^2.3.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.4",
    "read-package-up": "^11.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remend": "^1.3.1",
    "saxes": "6.0.0",
    "semver": "^7.7.2"
  }
}
